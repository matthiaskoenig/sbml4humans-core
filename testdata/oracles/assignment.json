          "math": {
            "formula": "PODOSE + IVDOSE",
            "latex": " \\mathit{PODOSE}+\\mathit{IVDOSE}"
          },
          "metaId": null,
          "name": null,
          "notes": "<notes>\n  <body xmlns=\"http://www.w3.org/1999/xhtml\">\n    <p>Using an InitialAssignment to set the total dose at the beginning\nof the simulation as sum from iv and oral dose.\nThe target parameter <code>D</code> of the initial assignment exists in the model.</p>\n  </body>\n</notes>",
          "pk": "assignment/InitialAssignment:D",
          "sbmlType": "InitialAssignment",
          "sbo": null,
          "symbol": "D",
          "uncertainties": [],
          "xml": "<initialAssignment symbol=\"D\">\n  <notes>\n    <body xmlns=\"http://www.w3.org/1999/xhtml\">\n      <p>Using an InitialAssignment to set the total dose at the beginning\nof the simulation as sum from iv and oral dose.\nThe target parameter <code>D</code> of the initial assignment exists in the model.</p>\n    </body>\n  </notes>\n  <math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n    <apply>\n      <plus/>\n      <ci> PODOSE </ci>\n      <ci> IVDOSE </ci>\n    </apply>\n  </math>\n</initialAssignment>"
        },
        {
          "comp": null,
          "cvterms": [],
          "derivedUnits": "l",
          "history": null,
          "id": null,
          "keyValuePairs": [],
          "lists": [],
          "math": {
            "formula": "BW * FVblood",
            "latex": " \\mathit{BW}\\cdot \\mathit{FVblood}"
          },
          "metaId": null,
          "name": null,
          "notes": "<notes>\n  <body xmlns=\"http://www.w3.org/1999/xhtml\">\n    <p>Calculating the blood volume via an Initial assignment.\nThe target of the initial assignment <code>Vblood</code> does not exist in the model\nso a corresponding parameter for the assignment is generated.</p>\n    <pre>\n      <code>    The `sid` can be used to set the id of the assignment.\n</code>\n    </pre>\n  </body>\n</notes>",
          "pk": "assignment/InitialAssignment:Vblood",
          "sbmlType": "InitialAssignment",
          "sbo": null,
          "symbol": "Vblood",
          "uncertainties": [],
          "xml": "<initialAssignment symbol=\"Vblood\">\n  <notes>\n    <body xmlns=\"http://www.w3.org/1999/xhtml\">\n      <p>Calculating the blood volume via an Initial assignment.\nThe target of the initial assignment <code>Vblood</code> does not exist in the model\nso a corresponding parameter for the assignment is generated.</p>\n      <pre>\n        <code>    The `sid` can be used to set the id of the assignment.\n</code>\n      </pre>\n    </body>\n  </notes>\n  <math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n    <apply>\n      <times/>\n      <ci> BW </ci>\n      <ci> FVblood </ci>\n    </apply>\n  </math>\n</initialAssignment>"
        }
